{
  "dashboard": {
    "title": "GenAI Platform — Production Dashboard",
    "uid": "genai-prod",
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [{"expr": "rate(genai_http_requests_total[5m])", "legendFormat": "{{method}} {{endpoint}}"}]
      },
      {
        "title": "Response Latency (p95)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [{"expr": "histogram_quantile(0.95, rate(genai_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"}]
      },
      {
        "title": "Error Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
        "targets": [{"expr": "sum(rate(genai_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(genai_http_requests_total[5m])) * 100"}]
      },
      {
        "title": "Active Pods",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
        "targets": [{"expr": "count(up{job=\"genai-platform\"})"}]
      },
      {
        "title": "LLM Latency (p95)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [{"expr": "histogram_quantile(0.95, rate(genai_llm_request_duration_seconds_bucket[5m]))", "legendFormat": "{{model}}"}]
      },
      {
        "title": "LLM Token Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {"expr": "rate(genai_llm_tokens_total{type=\"prompt\"}[5m])", "legendFormat": "Prompt Tokens/s"},
          {"expr": "rate(genai_llm_tokens_total{type=\"completion\"}[5m])", "legendFormat": "Completion Tokens/s"}
        ]
      },
      {
        "title": "RAG Retrieval Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [{"expr": "histogram_quantile(0.95, rate(genai_rag_retrieval_seconds_bucket[5m]))", "legendFormat": "p95 Retrieval"}]
      },
      {
        "title": "CPU & Memory Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {"expr": "avg(container_cpu_usage_seconds_total{pod=~\"genai.*\"})", "legendFormat": "CPU"},
          {"expr": "avg(container_memory_working_set_bytes{pod=~\"genai.*\"}) / 1e9", "legendFormat": "Memory (GB)"}
        ]
      }
    ]
  }
}
